{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ESNext",
    // `node` (node10) is deprecated and stops working in TypeScript 7. Rollup
    // does the actual bundling, so the modern bundler strategy is the accurate
    // one here and it keeps package.json `exports` resolution working.
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src", "rollup.config.ts"],
  "exclude": ["node_modules", "dist"]
}
