{
  "name": "vite-plugin-vux",
  "version": "1.1.1",
  "license": "MIT",
  "author": "JasonZhao",
  "description": "基于 Vite 插件，用于在 Vite 项目中使用 Vux 组件库",
  "keywords": [
    "vite",
    "plugin",
    "vux"
  ],
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development rollup --config rollup.config.ts --configPlugin typescript --watch",
    "build": "cross-env NODE_ENV=production rollup --config rollup.config.ts --configPlugin typescript",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm -C playground run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "release": "pnpm run build && npm publish"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "vue": "^2.7.0-0",
    "vux": "^2.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.13.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@babel/core": "^7.26.9",
    "@babel/types": "^7.29.11",
    "js-yaml": "^4.1.0",
    "strip-css-comments": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/babel__core": "^7.20.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "rollup": "^4.35.0",
    "rollup-plugin-copy": "^3.5.0",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^5.1.0",
    "vue": "^2.7.0-beta.8",
    "vux": "^2.11.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JasonZhao/vite-plugin-vux.git"
  },
  "bugs": {
    "url": "https://github.com/JasonZhao/vite-plugin-vux/issues"
  },
  "homepage": "https://github.com/JasonZhao/vite-plugin-vux#readme"
}
